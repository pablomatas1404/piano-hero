; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MiSimuladorDeVuelo"
run/main_scene="res://principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PerfilJugador="*res://perfil_jugador.gd"

[display]

window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/cesium_godot/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

# PROBANDO 2026-09-26: sacado "d3d12" (vuelve al default de Godot, Vulkan)
# para probar si es la causa de la pantalla partida/franja negra que
# apareció al agregar el primer SubViewport transparente del proyecto
# (MarcadoresViewport, en principal.tscn) -- combo conocido por dar
# problemas de compositing de transparencia. Si esto NO lo arregla, hay
# que revertir esta línea (rendering_device/driver.windows="d3d12") y
# seguir buscando por otro lado.
